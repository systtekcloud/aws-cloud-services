{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDevelopBranchApplyDev",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::899237616120:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:systtekcloud/aws-cloud-services:ref:refs/heads/develop"
        }
      }
    },
    {
      "Sid": "AllowMainBranchApplyProd",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::899237616120:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:systtekcloud/aws-cloud-services:ref:refs/heads/main"
        }
      }
    },
    {
      "Sid": "AllowDevEnvironmentApply",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::899237616120:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:systtekcloud/aws-cloud-services:environment:dev"
        }
      }
    },
    {
      "Sid": "AllowProductionEnvironmentApply",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::899237616120:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:systtekcloud/aws-cloud-services:environment:prod"
        }
      }
    },
    {
      "Sid": "AllowPullRequestPlan",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::899237616120:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": "repo:systtekcloud/aws-cloud-services:pull_request"
        }
      }
    }
  ]
}
